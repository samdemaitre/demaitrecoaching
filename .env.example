# Copy to .env.local for local development. In production, set these in your host.

# Coach admin password. REQUIRED in production (the /admin area is blocked without it).
# Username defaults to "coach" unless you change ADMIN_USER.
ADMIN_USER=coach
ADMIN_PASSWORD=

# Database connection. Auto-injected by Vercel when you create a Postgres store.
# Leave UNSET locally — the app falls back to a JSON file store in ./data/weekly-review.
# POSTGRES_URL=

# Anthropic API key. Enables dynamic, Claude-written dashboard copy (the bodyweight,
# energy-balance, and "you said X" narratives). If UNSET, the dashboard uses the
# built-in deterministic templates — everything still works, just less personalised.
# ANTHROPIC_API_KEY=
# Optional: override the model used for narrative copy (default: claude-opus-4-8).
# WEEKLY_REVIEW_MODEL=claude-opus-4-8
